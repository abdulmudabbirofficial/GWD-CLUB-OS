# Copy to backend/.env. Never commit .env, and never put these values in the app.

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Change Streams — the thing that makes live sync work — require a REPLICA SET.
# A plain standalone mongod has no oplog to watch and live sync will be off.
#
# Local development (single-node replica set, started by scripts/start-mongo.ps1):
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
#
# Production (MongoDB Atlas — replica set by default):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB=gwd_club_os

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000
# Lock this to your real web origin in production.
CLIENT_ORIGIN=*
CLUB_NAME=GWD Club

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-server-secret
JWT_EXPIRES_IN=30d

# ---------------------------------------------------------------------------
# Roots of trust (Section 4.5)
# ---------------------------------------------------------------------------
# The 2 Club Directors and the President are verified once and pre-seeded, so
# they never sit in an approval queue. Without them nobody can approve the first
# Lead and the club cannot bootstrap.
#
# Format: "Name:email:password" — comma-separated for the two Directors.
SEED_DIRECTORS=Director One:director1@gwd.club:ChangeThisPassword1,Director Two:director2@gwd.club:ChangeThisPassword2
SEED_PRESIDENT=President:president@gwd.club:ChangeThisPassword3

# ---------------------------------------------------------------------------
# Points (Section 8) — tunable constant
# ---------------------------------------------------------------------------
POINTS_PER_TASK=5

# ---------------------------------------------------------------------------
# Firebase Cloud Messaging — OPTIONAL
# ---------------------------------------------------------------------------
# Leave blank and the app works fine: in-app live toasts and the Notifications
# tab run over Socket.IO. Set this later to switch on background push, with no
# code change. Either inline JSON or a path to the service-account file.
# FIREBASE_SERVICE_ACCOUNT_JSON=./firebase-service-account.json

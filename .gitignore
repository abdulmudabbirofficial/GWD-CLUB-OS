# =============================================================================
# Secrets — never commit these
# =============================================================================
# backend/.env holds JWT_SECRET and the seeded Director / Faculty / President
# passwords in plain text. Committing it once puts them in the history forever,
# even if a later commit removes the file.
.env
.env.*
!.env.example
backend/.env

# Android release signing. The keystore *is* the app's identity — anyone with it
# can ship an update that phones accept as genuine.
key.properties
*.keystore
*.jks

# Firebase / FCM service account, when the club creates one.
google-services.json
GoogleService-Info.plist
firebase-service-account*.json

# =============================================================================
# Runtime data — belongs to the running club, not the source tree
# =============================================================================
# The live MongoDB data directory. This is the club's actual database: real
# people, real tasks. It is also ~200 MB of binary that changes every second.
backend/.mongo-data/
backend/uploads/

# Captured test output. Regenerated by running the suite; keeping it invites
# reading a stale run as the current state.
smoke.txt

# Server logs, wherever they land. Not merely noise: the startup log prints the
# six seeded Lead passwords once, in plain text. A stray server.log at the repo
# root very nearly went into the first commit.
*.log

# Records which LAN address the last APK was built against. Machine-specific.
.last-build-ip

# =============================================================================
# Build output and dependencies — reproducible, and enormous
# =============================================================================
node_modules/
build/
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
**/android/.gradle/
**/android/local.properties
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/App.framework/
**/ios/Flutter/Flutter.framework/
**/ios/Pods/
**/ios/.symlinks/
**/Podfile.lock

# Packaged apps. GitHub rejects files over 100 MB and these are rebuilt from
# source anyway — attach them to a Release instead of committing them.
*.apk
*.aab
*.ipa

# =============================================================================
# Editors and OS noise
# =============================================================================
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
desktop.ini
